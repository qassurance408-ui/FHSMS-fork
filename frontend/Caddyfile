# Caddy config for the FHSMS web container.
# {$VAR:default} placeholders are filled from environment variables at start-up.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Backend API + health check -> API container
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}
	handle /health {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	# Everything else -> the React app (with SPA fallback for client-side routes)
	handle {
		root * /srv
		@nocache path /index.html /sw.js /registerSW.js /config.js /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
