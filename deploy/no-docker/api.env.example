# Copy to /etc/fhsms/api.env  (chmod 600, owner root). One KEY=value per line, no quotes.
ASPNETCORE_ENVIRONMENT=Production
# Listen only on localhost - nginx (or IIS/Apache) is the public front door.
ASPNETCORE_URLS=http://127.0.0.1:5080
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Database: either the ADO.NET string...
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=fhsms;Username=fhsms_user;Password=CHANGE_ME
# ...or a postgres:// URI (managed databases) - overrides the line above.
# Add ?sslmode=disable if that database has SSL switched off.
# DATABASE_URL=postgres://user:password@db-host:5432/fhsms

Jwt__Secret=CHANGE_ME_at_least_32_random_characters
Jwt__Issuer=FHSMS.API
Jwt__Audience=FHSMS.Clients
Jwt__ExpiryMinutes=480

# Your public site address (no trailing slash)
ALLOWED_ORIGINS=https://agrilink.example.com
PaymentProviders__ApiPublicBaseUrl=https://agrilink.example.com
PaymentProviders__FrontendPublicBaseUrl=https://agrilink.example.com

# First-run admin (used once, when the database is empty)
SEED_ADMIN_EMAIL=admin@fhsms.local
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Telebirr (optional) - from Ethio Telecom's developer portal
PaymentProviders__Telebirr__FabricAppId=
PaymentProviders__Telebirr__AppSecret=
PaymentProviders__Telebirr__MerchantAppId=
PaymentProviders__Telebirr__MerchantCode=
PaymentProviders__Telebirr__MerchantPrivateKeyPem=
PaymentProviders__Telebirr__TelebirrPublicKeyPem=
PaymentProviders__Telebirr__ApiBaseUrl=
PaymentProviders__Telebirr__WebCheckoutBaseUrl=

# Chapa (optional)
PaymentProviders__Chapa__Secret=
