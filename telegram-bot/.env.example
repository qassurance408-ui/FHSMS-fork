# Template only - copy this to .env and fill in real values for LOCAL
# TESTING (e.g. `docker run --env-file .env ...`). The real .env is
# gitignored and must never be committed - only this .example file, with
# placeholders, belongs in the repo.
#
# For everyday local development without Docker, `dotnet user-secrets` is
# the better fit - see telegram-bot/README.md.

# From @BotFather on Telegram - never commit a real one.
Telegram__BotToken=

Fhsms__ApiBaseUrl=http://localhost:5080/api
# An existing admin/staff account the bot signs in as to call the API.
Fhsms__ServiceAccountEmail=admin@fhsms.local
Fhsms__ServiceAccountPassword=
