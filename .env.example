# ---------------------------------------------------------------------------
# FHSMS / AgriLink - production settings for docker-compose.prod.yml
#
#   cp .env.example .env     (or run  bash deploy/setup.sh  to create it for you)
#
# Keep .env private (never commit it). Use only letters, numbers and - _ . in
# passwords/secrets: avoid spaces, quotes, $ and ; so nothing gets mangled.
# ---------------------------------------------------------------------------

# --- Address of your site --------------------------------------------------
# With a domain name (recommended - free automatic HTTPS):
#   SITE_ADDRESS=agrilink.example.com
#   PUBLIC_URL=https://agrilink.example.com
# With just a server IP address (plain HTTP):
#   SITE_ADDRESS=:80
#   PUBLIC_URL=http://196.190.0.10
# PUBLIC_URL has NO trailing slash.
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost

# --- Database (the bundled PostgreSQL container) -----------------------------
POSTGRES_DB=fhsms
POSTGRES_USER=fhsms_user
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_password

# Using a managed/external PostgreSQL instead? Set this (it overrides the above)
# and start only web+api:
#   docker compose -f docker-compose.prod.yml up -d --build --no-deps web api
#   DATABASE_URL=postgres://user:password@db-host:5432/fhsms
#   add ?sslmode=disable if that database does not use SSL
# DATABASE_URL=

# --- Security --------------------------------------------------------------
# 32+ random characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_to_at_least_32_random_characters

# --- First admin login (created once, on the very first start) -------------
# Change the password after logging in for the first time as well.
ADMIN_EMAIL=admin@fhsms.local
ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Telegram bot (optional) -------------------------------------------------
# Get a token from @BotFather, then uncomment BOTH lines to start the bot.
# TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# COMPOSE_PROFILES=telegram

# --- Payment providers (optional - fill in when you have the credentials) ---
PAYMENT_BANKTRANSFER_SECRET=
PAYMENT_CHAPA_SECRET=
PAYMENT_CBEBIRR_SECRET=
# Telebirr - from Ethio Telecom's developer portal after your merchant team/
# product is approved. ApiBaseUrl/WebCheckoutBaseUrl differ between the
# sandbox and production - the portal gives you both.
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_MERCHANT_PRIVATE_KEY_PEM=
TELEBIRR_PUBLIC_KEY_PEM=
TELEBIRR_API_BASE_URL=
TELEBIRR_WEB_CHECKOUT_BASE_URL=

# --- Advanced (rarely needed) ------------------------------------------------
# Change if ports 80/443 are already used by something else on the server.
# HTTP_PORT=80
# HTTPS_PORT=443
# Only if the API is on a different domain than the website:
# VITE_API_BASE_URL=https://api.example.com/api
